# Bot Token dari @BotFather di Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Zona Waktu (Default: Asia/Jakarta untuk WIB)
TIMEZONE=Asia/Jakarta

# Database path (Default: ./data/schedule.db)
DATABASE_PATH=./data/schedule.db

# Kunci rahasia untuk mengenkripsi password portal yang disimpan
# (Opsional, default memakai BOT_TOKEN. Jika diganti, kredensial lama tidak bisa dibaca)
CREDENTIAL_SECRET=ganti_dengan_string_acak_panjang
